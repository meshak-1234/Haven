# ==========================================
# Haven — AI Companion
# Environment Configuration Template
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# ──────────────────────────────────────────
# AI Provider Configuration
# ──────────────────────────────────────────
# Set AI_PROVIDER to 'gemini' (requires GEMINI_API_KEY)
# or 'mock' for local testing without an API key.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ──────────────────────────────────────────
# Database Configuration
# ──────────────────────────────────────────
#
# OPTION A — Individual connection variables (recommended for external SQL):
#   Set DB_TYPE to: sqlite | mysql | postgresql
#   Leave DATABASE_URL empty when using this option.
#
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=haven
DB_USER=root
DB_PASSWORD=your_password_here
#
# OPTION B — Direct connection URL (overrides Option A when set):
#   mysql+pymysql://username:password@127.0.0.1:3306/haven
#   postgresql+psycopg2://username:password@127.0.0.1:5432/haven
#   sqlite:///./haven.db
#
DATABASE_URL=sqlite:///./haven.db

# ──────────────────────────────────────────
# Authentication & Security
# ──────────────────────────────────────────
# Generate a secure 32+ character random secret for JWT signing.
# Example (PowerShell): -join ((65..90)+(97..122)+(48..57)|Get-Random -Count 40|%{[char]$_})
JWT_SECRET=replace-this-with-a-secure-random-secret-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
